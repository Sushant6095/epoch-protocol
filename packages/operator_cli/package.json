{
  "name": "@epoch/operator_cli",
  "version": "0.1.0",
  "private": true,
  "description": "Epoch operator script: pool admin (init, roles, pause) and onboarded validators (onboarding, commission, identity, bond, revenue token, release)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "epoch-operator": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint --fix src",
    "test": "jest --config ../../jest.config.base.js --rootDir . --passWithNoTests",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@epoch/common": "workspace:*",
    "@epoch/config-sdk": "workspace:*",
    "@epoch/epoch-sdk": "workspace:*",
    "@epoch/solana": "workspace:*",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  }
}
