{
  "name": "@epoch/common_http_server",
  "version": "0.1.0",
  "private": true,
  "description": "Express server wrapper: tracing, access logs, validation, error mapping, response types",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "jest --config ../../jest.config.base.js --rootDir . --passWithNoTests"
  },
  "dependencies": {
    "@epoch/common": "workspace:*",
    "@epoch/exceptions": "workspace:*",
    "@epoch/logger": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.0"
  }
}
