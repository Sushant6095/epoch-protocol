{
  "name": "@epoch/epoch-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe TypeScript client for the Epoch program: PDAs, account and event decoders, instruction builders, errors, math mirror",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint --fix src",
    "test": "jest --config ../../jest.config.base.js --rootDir . --passWithNoTests",
    "vectors": "cargo run --offline --release --manifest-path vectors/Cargo.toml"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  }
}
