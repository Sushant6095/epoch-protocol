{
  "name": "@epoch/common",
  "version": "0.1.0",
  "private": true,
  "description": "Shared constants, env loading, graceful shutdown, helpers and wrapped third-party modules",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./first-module": {
      "types": "./dist/first-module.d.ts",
      "default": "./dist/first-module.js"
    },
    "./pkg/*": {
      "types": "./dist/pkg/*.d.ts",
      "default": "./dist/pkg/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "jest --config ../../jest.config.base.js --rootDir . --passWithNoTests"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  }
}
