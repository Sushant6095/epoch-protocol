{
  "name": "@epoch/cranks_app",
  "version": "0.1.0",
  "private": true,
  "description": "Epoch-boundary jobs (score, sweep, mark default, accrue, withdrawals) and the Fee Index finalize / swap settle poller",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint --fix src",
    "test": "jest --config ../../jest.config.base.js --rootDir . --passWithNoTests",
    "start": "node dist/index.js",
    "watch": "tsx watch src/index.ts",
    "start:claims": "node dist/launch-claims.js"
  },
  "dependencies": {
    "@epoch/common": "workspace:*",
    "@epoch/config-sdk": "workspace:*",
    "@epoch/epoch-sdk": "workspace:*",
    "@epoch/exceptions": "workspace:*",
    "@epoch/logger": "workspace:*",
    "@epoch/meteora": "workspace:*",
    "@epoch/solana": "workspace:*",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  }
}
