{
  "name": "@epoch/meteora",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe helpers for Epoch's revenue tokens on Meteora: DBC curve and DAMM v2 reads, trade quotes and transactions, the revenue-anchored curve",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src scripts --max-warnings=0",
    "lint:fix": "eslint --fix src scripts",
    "test": "jest --config ../../jest.config.base.js --rootDir . --passWithNoTests",
    "launch": "tsx scripts/launch-revenue-token.ts"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.0"
  }
}
