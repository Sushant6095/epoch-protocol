{
  "name": "@epoch/api_app",
  "version": "0.1.0",
  "private": true,
  "description": "REST + websocket API for the Epoch app",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "jest --config ../../jest.config.base.js --rootDir . --passWithNoTests",
    "start": "node dist/index.js",
    "watch": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@epoch/common": "workspace:*",
    "@epoch/common_http_server": "workspace:*",
    "@epoch/config-sdk": "workspace:*",
    "@epoch/exceptions": "workspace:*",
    "@epoch/logger": "workspace:*",
    "@epoch/pg_models": "workspace:*",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  }
}
