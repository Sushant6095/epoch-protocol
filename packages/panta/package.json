{
  "name": "@epoch/panta",
  "version": "0.1.0",
  "private": true,
  "description": "Typed, rate-budgeted client for the Panta public API (USDC prediction markets on Solana): zod-validated responses, typed errors, unsigned-transaction helpers",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint --fix src",
    "test": "jest --config ../../jest.config.base.js --rootDir . --passWithNoTests"
  },
  "dependencies": {
    "@epoch/common": "workspace:*",
    "@epoch/epoch-sdk": "workspace:*",
    "@epoch/logger": "workspace:*",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  }
}
