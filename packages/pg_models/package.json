{
  "name": "@epoch/pg_models",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres schema (drizzle), connection manager and migrations",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "jest --config ../../jest.config.base.js --rootDir . --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/MigrationManager/RunMigration.js"
  },
  "dependencies": {
    "@epoch/common": "workspace:*",
    "@epoch/config-sdk": "workspace:*",
    "@epoch/logger": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
