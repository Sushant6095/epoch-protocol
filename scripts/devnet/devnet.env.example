# Epoch keepers on devnet (docs/runbooks/devnet.md). No secrets in this file: public RPCs and key PATHS only.
# Copy it OUTSIDE the repo and fill in the paths, then start the keepers with:
#   pnpm build && EPOCH_ENV_FILE=/abs/path/devnet.env pm2 start scripts/devnet/pm2.devnet.config.js
# The key files are the ones `pnpm devnet init` created in the kit's key folder (--keys).

NODE_ENV=production
LOG_LEVEL=info

# The program on devnet: cranks, publisher and the API read and write here.
EPOCH_CLUSTER=devnet
EPOCH_RPC_URL=https://api.devnet.solana.com
EPOCH_PROGRAM_ID=<the program id pnpm devnet deploy printed>

# Mainnet data, read only: validator history for the scorer, the Fee Index inputs for the publisher.
DATA_RPC_URL=https://api.mainnet-beta.solana.com

# Postgres for the indexer (and the API if you run it).
DATABASE_URL=postgres://epoch:epoch@127.0.0.1:5432/epoch_devnet

# The publisher posts each finished mainnet epoch's Fee Index under devnet's current epoch − 1. A fixed offset drifts:
# devnet's slots are 0.239 s since Alpenglow, mainnet's ≈ 0.4 s (packages/publisher_app/README.md). The API numbers
# its Fee Index points by the same mapping (mainnet epochs, with each value's devnet epoch beside).
FEE_INDEX_EPOCH_OFFSET=auto

# Keeper keys (paths outside the repo; never the deployer's key).
CRANK_KEYPAIR_PATH=/abs/path/to/keys/cranker.json
SCORER_KEYPAIR_PATH=/abs/path/to/keys/scorer.json
PUBLISHER_KEYPAIR_PATH=/abs/path/to/keys/publisher.json
MAKER_KEYPAIR_PATH=/abs/path/to/keys/maker.json
# Fee Index operators `pnpm devnet init` registered (operator consensus): the publisher votes with each key.
INDEX_OPERATOR_KEYPAIR_PATHS=/abs/path/to/keys/index-operator-1.json,/abs/path/to/keys/index-operator-2.json,/abs/path/to/keys/index-operator-3.json

# Panta bot: no API key here, so every Panta feature stays off; dry run as a second guard. This setup never calls
# Panta's live API.
PANTA_DRY_RUN=true
