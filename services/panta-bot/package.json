{
  "name": "@epoch/panta-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Creates next epoch's parimutuel market on Panta and resolves the finished one from the fee index.",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc -p .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@epoch/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  }
}
