{
  "name": "@epoch/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Yellowstone gRPC (Solami primary, RPC Fast failover) to per-slot fees, per-epoch Solana Fee Index and per-validator revenue in Postgres.",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc -p .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@triton-one/yellowstone-grpc": "^7.0.1",
    "pg": "^8.16.0",
    "@epoch/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  }
}
