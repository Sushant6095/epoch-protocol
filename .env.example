# Solana RPC (mainnet / devnet)
RPC_URL=https://api.devnet.solana.com
MAINNET_RPC_URL=

# Solami (Yellowstone gRPC, needs Pro plan) and RPC Fast
SOLAMI_GRPC_URL=grpc.solami.dev:443
SOLAMI_TOKEN=
RPC_FAST_URL=
RPC_FAST_GRPC_URL=
RPC_FAST_TOKEN=

# Database (Supabase Postgres)
DATABASE_URL=

# Keeper / publisher wallets: paths to keypair files kept OUTSIDE the repo
CRANK_KEYPAIR_PATH=~/.config/solana/epoch-crank.json
PUBLISHER_KEYPAIR_PATH=~/.config/solana/epoch-publisher.json

# Panta
PANTA_API_URL=
PANTA_API_KEY=
