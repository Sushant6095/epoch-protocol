# Names only: set the values in the deployment (Vercel project settings or a local .env.local that is never committed).
# Every variable is optional; the defaults are in src/lib/env.ts.

# The Epoch API (packages/api_app). Every page reads it; WS /v1/stream is on the same host. Default: http://localhost:4000
NEXT_PUBLIC_EPOCH_API_URL=
# The same API as the Next.js server reaches it, for the /api/probe health check (e.g. a private URL). Default: the public one.
EPOCH_API_URL_INTERNAL=
# Solana mainnet RPC for the wallet connection.
NEXT_PUBLIC_SOLANA_RPC_URL=
# The Epoch program's cluster RPC (devnet for now): Redeem is sent here.
NEXT_PUBLIC_EPOCH_RPC_URL=
# The launch cluster's RPC: Launch buys and sells are sent here. Default: NEXT_PUBLIC_EPOCH_RPC_URL.
NEXT_PUBLIC_LAUNCH_RPC_URL=
# The Epoch program id, needed to build Redeem with @epoch/epoch-sdk. Unset: Redeem is shown but disabled.
NEXT_PUBLIC_EPOCH_PROGRAM_ID=
# Set to "sample" to force sample mode (fixtures, labelled Sample) even when the API answers.
NEXT_PUBLIC_EPOCH_DATA=
NEXT_PUBLIC_EPOCH_NETWORK=
