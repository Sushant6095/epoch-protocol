{
  "permissions": {
    "allow": [
      "Bash(pnpm --filter app:*)",
      "Bash(pnpm install)",
      "Bash(pnpm dlx shadcn@latest:*)",
      "Bash(npx shadcn@latest:*)",
      "Bash(node scripts/ui/screenshot.mjs:*)",
      "Bash(npx impeccable detect:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --rebase:*)",
      "mcp__refero",
      "mcp__shadcn",
      "mcp__magicui",
      "mcp__context7",
      "mcp__playwright",
      "mcp__chrome-devtools",
      "mcp__reui",
      "mcp__solana-dev"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development.local)",
      "Read(./.env.production.local)",
      "Read(../.env)",
      "Read(../.env.local)",
      "Read(~/.config/solana/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/scope-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\""
          }
        ]
      }
    ]
  }
}
